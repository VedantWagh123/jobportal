<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= resumeName %></title>
    
    <%
        const fontToUrl = {
            'Inter': 'family=Inter:wght@400;500;600;700',
            'Roboto': 'family=Roboto:wght@400;500;700',
            'Merriweather': 'family=Merriweather:wght@400;700',
            'Outfit': 'family=Outfit:wght@400;500;600;700'
        };
        const customFont = locals.design && locals.design.fontFamily ? locals.design.fontFamily : null;
        const fontUrl = customFont && fontToUrl[customFont] ? `https://fonts.googleapis.com/css2?${fontToUrl[customFont]}&display=swap` : null;
    %>
    
    <% if (fontUrl) { %>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="<%= fontUrl %>" rel="stylesheet">
    <% } %>

    <style>
        /* Base Styles - A4 format */
        @page {
            size: A4;
            margin: 0; /* Handled by body padding */
        }
        
        * {
            box-sizing: border-box;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 40px;
            color: #1f2937;
            background: #ffffff;
            font-size: 11px;
            line-height: 1.5;
        }

        /* ----- ATS Classic Template ----- */
        body.template-ats-classic {
            font-family: "Times New Roman", Times, serif;
            color: #000;
            padding: 40px 56px; /* 40px top/bottom, 56px left/right */
        }
        .template-ats-classic h1 { font-size: 26px; font-weight: bold; text-transform: uppercase; text-align: center; margin: 0 0 2px 0; letter-spacing: 1px; }
        .template-ats-classic .contact-info { display: flex; flex-wrap: wrap; justify-content: center; margin-top: 5px; margin-bottom: 15px; font-size: 11px; }
        .template-ats-classic .section-title { 
            font-size: 13px; border-bottom: 1px solid #000; margin: 12px 0 8px 0; font-weight: bold; padding-bottom: 2px;
        }
        
        /* ----- Modern Professional Template ----- */
        body.template-modern-professional {
            color: #333;
        }
        .template-modern-professional h1 { font-size: 28px; color: #2563eb; margin: 0 0 5px 0; }
        .template-modern-professional .contact-info { display: flex; flex-wrap: wrap; gap: 15px; margin-bottom: 20px; color: #4b5563; }
        .template-modern-professional .section-title {
            font-size: 14px; color: #2563eb; border-bottom: 2px solid #e5e7eb; margin: 20px 0 12px 0; font-weight: 600; text-transform: uppercase; padding-bottom: 4px;
        }

        /* ----- Tech Professional Template ----- */
        body.template-tech-professional {
            font-family: 'Roboto Mono', 'Courier New', monospace; /* Will fallback to standard sans if not embedded, but we keep it clean */
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }
        .template-tech-professional h1 { font-size: 26px; font-weight: 800; margin: 0 0 5px 0; }
        .template-tech-professional .contact-info { display: flex; gap: 10px; margin-bottom: 15px; border-bottom: 1px solid #e5e7eb; padding-bottom: 10px; }
        .template-tech-professional .section-title {
            font-size: 12px; background: #f3f4f6; padding: 4px 8px; font-weight: bold; text-transform: uppercase; margin: 15px 0 10px 0; display: inline-block;
        }

        /* ----- Minimal Executive Template ----- */
        body.template-minimal-executive {
            color: #111827;
        }
        .template-minimal-executive h1 { font-size: 24px; font-weight: 300; letter-spacing: 2px; margin: 0 0 10px 0; text-align: center; }
        .template-minimal-executive .contact-info { display: flex; flex-wrap: wrap; justify-content: center; gap: 20px; margin-bottom: 25px; color: #6b7280; font-size: 10px; text-transform: uppercase; letter-spacing: 1px;}
        .template-minimal-executive .section-title {
            font-size: 12px; color: #9ca3af; text-transform: uppercase; letter-spacing: 2px; margin: 20px 0 10px 0; border-bottom: 1px solid #f3f4f6; padding-bottom: 5px;
        }

        /* Custom User Overrides */
        <% if (customFont) { %>
            body, body.template-ats-classic, body.template-modern-professional, body.template-tech-professional, body.template-minimal-executive {
                font-family: '<%= customFont %>', sans-serif !important;
            }
        <% } %>

        /* Common Layout Utilities */
        .link { color: #2563eb; text-decoration: none; }
        .header { margin-bottom: 15px; }
        .job-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px; }
        .job-title { font-weight: bold; font-size: 12px; }
        .company-name { font-style: italic; }
        .date-range { font-size: 10px; color: #4b5563; }
        .item-block { margin-bottom: 12px; }
        .item-desc { margin-top: 4px; }
        ul { margin: 4px 0 0 0; padding-left: 20px; }
        li { margin-bottom: 3px; }
        
        .skills-grid { display: flex; flex-wrap: wrap; gap: 4px; }
        .skill-badge {
            display: inline-block;
            background: #f3f4f6;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 10px;
        }
        .template-ats-classic .skill-badge { background: none; padding: 0; font-size: 11px; }
        .template-ats-classic .skill-badge::after { content: ", "; }
        .template-ats-classic .skill-badge:last-child::after { content: ""; }

        .summary { text-align: justify; }
        
        .link { color: #2563eb !important; text-decoration: none; }
        .link:hover { text-decoration: underline; }

        .contact-item { display: inline-flex; align-items: center; gap: 4px; margin: 0 8px; }
        .contact-item svg { width: 11px; height: 11px; }
    </style>
</head>
<% 
    let templateClass = 'template-ats-classic';
    if(template === 'Modern Professional') templateClass = 'template-modern-professional';
    if(template === 'Tech Professional') templateClass = 'template-tech-professional';
    if(template === 'Minimal Executive') templateClass = 'template-minimal-executive';
%>
<body class="<%= templateClass %>">
    <div id="resume-wrapper" style="width: 100%; transform-origin: top center;">
    <div class="header" style="text-align: center; width: 100%;">
        <h1 style="text-align: center; margin: 0 auto 2px auto;"><%= personalInfo?.fullName || 'Your Name' %></h1>
        
        <% if (templateClass === 'template-ats-classic') { %>
            <div style="font-size: 13px; text-align: center; margin-bottom: 2px; color: #374151;">
                <% const line1 = []; %>
                <% if (personalInfo?.professionalTitle) line1.push(personalInfo.professionalTitle); %>
                <% if (personalInfo?.location) line1.push(personalInfo.location); %>
                <%= line1.join(' | ') %>
            </div>
            <div style="font-size: 11.5px; text-align: center; margin-bottom: 15px; color: #4b5563;">
                <% const line2 = []; %>
                <% if (personalInfo?.email) line2.push(`<a class="link" href="mailto:${personalInfo.email}">${personalInfo.email}</a>`); %>
                <% if (personalInfo?.phone) line2.push(personalInfo.phone); %>
                <% if (personalInfo?.linkedin) line2.push(`<a class="link" href="${personalInfo.linkedin.startsWith('http') ? personalInfo.linkedin : 'https://' + personalInfo.linkedin}">${personalInfo.linkedin.replace(/^https?:\\/\\/(www\\.)?/, '')}</a>`); %>
                <% if (personalInfo?.portfolioUrl || personalInfo?.github) {
                    const url = personalInfo.portfolioUrl || personalInfo.github;
                    line2.push(`<a class="link" href="${url.startsWith('http') ? url : 'https://' + url}">${url.replace(/^https?:\\/\\/(www\\.)?/, '')}</a>`);
                } %>
                <%- line2.join(' | ') %>
            </div>
        <% } else { %>
            <% if (personalInfo?.location) { %>
                <div style="text-align: center; margin-bottom: 4px; font-size: 11px;"><%= personalInfo.location %></div>
            <% } %>
            <% if (personalInfo?.professionalTitle) { %>
                <div style="font-size: 14px; text-align: center; margin-bottom: 5px; text-transform: capitalize; font-weight: <%= templateClass === 'template-modern-professional' ? '600' : 'normal' %>; color: <%= templateClass === 'template-modern-professional' ? '#2563eb' : 'inherit' %>;"><%= personalInfo.professionalTitle %></div>
            <% } %>
            
            <div class="contact-info" style="display: flex; flex-direction: column; align-items: <%= templateClass === 'template-tech-professional' ? 'flex-start' : 'center' %>; gap: 4px;">
                <div style="display: flex; flex-wrap: wrap; gap: 15px; justify-content: center;">
                    <% if (personalInfo?.email) { %><span class="contact-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:12px; height:12px; vertical-align:-2px;"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg> <a class="link" href="mailto:<%= personalInfo.email %>"><%= personalInfo.email %></a></span><% } %>
                    <% if (personalInfo?.phone) { %><span class="contact-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:12px; height:12px; vertical-align:-2px;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg> <%= personalInfo.phone %></span><% } %>
                </div>
                <div style="display: flex; flex-wrap: wrap; gap: 15px; justify-content: center;">
                    <% if (personalInfo?.linkedin) { %><span class="contact-item"><svg viewBox="0 0 24 24" fill="currentColor" style="width:12px; height:12px; vertical-align:-2px;"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg> <a class="link" href="<%= personalInfo.linkedin.startsWith('http') ? personalInfo.linkedin : 'https://' + personalInfo.linkedin %>"><%= personalInfo.linkedin.replace(/^https?:\/\/(www\.)?/, '') %></a></span><% } %>
                    <% if (personalInfo?.portfolioUrl || personalInfo?.github) { %><span class="contact-item"><svg viewBox="0 0 24 24" fill="currentColor" style="width:12px; height:12px; vertical-align:-2px;"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg> <a class="link" href="<%= personalInfo.portfolioUrl || personalInfo.github %>"><%= (personalInfo.portfolioUrl || personalInfo.github).replace(/^https?:\/\/(www\.)?/, '') %></a></span><% } %>
                </div>
            </div>
        <% } %>
    </div>

    <% 
        const renderList = (text) => {
            if(!text) return '';
            const lines = text.split('\n').filter(l => l.trim().length > 0);
            if(lines.length > 0 && lines[0].startsWith('-')) {
                return `<ul>${lines.map(l => `<li>${l.replace(/^-/, '').trim()}</li>`).join('')}</ul>`;
            }
            return `<div>${text}</div>`;
        };

        const renderSkillGroup = (name, arr) => {
            if(!arr || arr.length === 0) return '';
            let html = `<div style="margin-bottom: 4px;"><strong>${name}:</strong> <div class="skills-grid" style="display:inline-flex;">`;
            arr.forEach(s => { html += `<span class="skill-badge">${s}</span>`; });
            html += `</div></div>`;
            return html;
        };

        const sectionsHtml = {};

        if (summary) {
            sectionsHtml['summary'] = `
            <div class="section">
                <div class="section-title">Professional Summary</div>
                <div class="summary">${summary}</div>
            </div>`;
        }

        if (experience && experience.length > 0) {
            let html = `<div class="section"><div class="section-title">Experience</div>`;
            experience.forEach(exp => {
                html += `<div class="item-block">
                            <div class="job-header">
                                <div>
                                    <span class="job-title">${exp.jobTitle}</span>
                                    ${exp.company ? `<span class="company-name">, ${exp.company}</span>` : ''}
                                    ${exp.location ? `<span>, ${exp.location}</span>` : ''}
                                </div>
                                <div class="date-range">
                                    ${exp.startDate || '...'} - ${exp.currentlyWorking ? 'Present' : (exp.endDate || '...')}
                                </div>
                            </div>
                            ${exp.responsibilities ? `<div class="item-desc">${renderList(exp.responsibilities)}</div>` : ''}
                        </div>`;
            });
            html += `</div>`;
            sectionsHtml['experience'] = html;
        }

        if (projects && projects.length > 0) {
            let html = `<div class="section"><div class="section-title">Projects</div>`;
            projects.forEach(proj => {
                html += `<div class="item-block">
                            <div class="job-header">
                                <div>
                                    <span class="job-title">${proj.projectName}</span>
                                    ${proj.role ? `<span> - ${proj.role}</span>` : ''}
                                </div>
                                <div class="date-range">
                                    ${proj.liveDemoUrl ? `<a class="link" href="${proj.liveDemoUrl}">Live Demo</a>` : ''}
                                    ${proj.githubUrl ? `${proj.liveDemoUrl ? ' | ' : ''}<a class="link" href="${proj.githubUrl}">GitHub</a>` : ''}
                                </div>
                            </div>
                            ${proj.technologies && proj.technologies.length > 0 ? `<div style="font-size: 10px; margin-bottom: 4px; color: #4b5563;"><em>Tech: ${proj.technologies.join(', ')}</em></div>` : ''}
                            ${proj.description ? `<div class="item-desc">${renderList(proj.description)}</div>` : ''}
                        </div>`;
            });
            html += `</div>`;
            sectionsHtml['projects'] = html;
        }

        if (skills && (skills.technical?.length > 0 || skills.softSkills?.length > 0 || skills.frameworks?.length > 0 || skills.tools?.length > 0 || skills.programmingLanguages?.length > 0 || skills.databases?.length > 0)) {
            let html = `<div class="section"><div class="section-title">Skills</div>`;
            html += renderSkillGroup('Technical', skills.technical);
            html += renderSkillGroup('Languages', skills.programmingLanguages);
            html += renderSkillGroup('Frameworks', skills.frameworks);
            html += renderSkillGroup('Databases', skills.databases);
            html += renderSkillGroup('Tools', skills.tools);
            html += renderSkillGroup('Soft Skills', skills.softSkills);
            html += `</div>`;
            sectionsHtml['skills'] = html;
        }

        if (education && education.length > 0) {
            let html = `<div class="section"><div class="section-title">Education</div>`;
            education.forEach(edu => {
                html += `<div class="item-block">
                            <div class="job-header">
                                <div>
                                    <span class="job-title">${edu.degree}</span>
                                    ${edu.institution ? `<span>, ${edu.institution}</span>` : ''}
                                    ${edu.location ? `<span>, ${edu.location}</span>` : ''}
                                </div>
                                <div class="date-range">
                                    ${edu.startYear || '...'} - ${edu.endYear || '...'}
                                </div>
                            </div>
                            ${(edu.score || edu.coursework) ? `<div style="margin-top: 2px;">
                                ${edu.score ? `<strong>Score:</strong> ${edu.score}` : ''}
                                ${edu.coursework ? ` | <strong>Coursework:</strong> ${edu.coursework}` : ''}
                            </div>` : ''}
                        </div>`;
            });
            html += `</div>`;
            sectionsHtml['education'] = html;
        }

        if (typeof certifications !== 'undefined' && certifications && certifications.length > 0) {
            let html = `<div class="section"><div class="section-title">Certifications</div>`;
            certifications.forEach(cert => {
                html += `<div class="item-block">
                            <div class="job-header">
                                <div>
                                    <span class="job-title">${cert.certificateName}</span>
                                    ${cert.issuingOrganization ? `<span class="company-name">, ${cert.issuingOrganization}</span>` : ''}
                                </div>
                                <div class="date-range">
                                    ${cert.issueDate || '...'}
                                </div>
                            </div>
                            ${cert.credentialId ? `<div style="margin-top: 2px; font-size: 10px;"><strong>Credential ID:</strong> ${cert.credentialId}</div>` : ''}
                            ${cert.credentialUrl ? `<div style="margin-top: 2px; font-size: 10px;"><a class="link" href="${cert.credentialUrl}">View Credential</a></div>` : ''}
                        </div>`;
            });
            html += `</div>`;
            sectionsHtml['certifications'] = html;
        }

        if (typeof achievements !== 'undefined' && achievements && achievements.length > 0) {
            let html = `<div class="section"><div class="section-title">Achievements</div>`;
            achievements.forEach(ach => {
                html += `<div class="item-block">
                            <div class="job-header">
                                <div>
                                    <span class="job-title">${ach.achievementName}</span>
                                    ${ach.organization ? `<span>, ${ach.organization}</span>` : ''}
                                </div>
                                <div class="date-range">
                                    ${ach.date || '...'}
                                </div>
                            </div>
                            ${ach.description ? `<div class="item-desc" style="text-align:justify;">${ach.description}</div>` : ''}
                        </div>`;
            });
            html += `</div>`;
            sectionsHtml['achievements'] = html;
        }

        const defaultOrder = ['summary', 'experience', 'projects', 'skills', 'education', 'certifications', 'achievements'];
        const activeOrder = (typeof sectionOrder !== 'undefined' && sectionOrder && sectionOrder.length > 0) ? sectionOrder : defaultOrder;
    %>

    <% activeOrder.forEach(section => { %>
        <%- sectionsHtml[section] || '' %>
    <% }); %>
    </div>
    
    <% if (templateClass === 'template-ats-classic') { %>
    <script>
        // Auto-scale content to fit strictly on 1 A4 page
        window.onload = function() {
            var wrapper = document.getElementById('resume-wrapper');
            var contentHeight = wrapper.scrollHeight;
            var targetHeight = 1122 - 80; // A4 height minus 40px top/bottom padding
            
            if (contentHeight > targetHeight) {
                var scale = targetHeight / contentHeight;
                wrapper.style.transform = 'scale(' + scale + ')';
            }
        };
    </script>
    <% } %>
</body>
</html>
